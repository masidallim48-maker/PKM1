# Salin file ini menjadi .env.local lalu isi alamat backend Anda.
# Contoh Laravel: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
# Sesuaikan dengan path route API Laravel Anda.
# Siswa: GET dengan query search/page dan POST untuk tambah siswa.
VITE_DATA_SISWA_ENDPOINT=/api/data_siswa
# Guru: GET dengan query search/page dan POST untuk tambah guru.
VITE_DATA_GURU_ENDPOINT=/api/data_guru
# Endpoint login awal; sesuaikan dengan route backend saat tersedia.
VITE_LOGIN_ENDPOINT=/api/login
# Endpoint pendaftaran akun (POST JSON).
VITE_REGISTER_ENDPOINT=/api/register
# Endpoint scan presensi: POST { sn, jenis_absensi: "masuk" | "pulang" }.
VITE_ATTENDANCE_ENDPOINT=/api/absensi
# Kelas: GET/POST daftar, GET/PUT /{id_kelas} detail/edit.
# Dipakai juga untuk pilihan kelas pada form siswa dan riwayat absensi.
VITE_CLASSES_ENDPOINT=/api/kelas
# Riwayat presensi (GET).
VITE_ATTENDANCE_HISTORY_ENDPOINT=/api/absensi/riwayat
